# ---------------------------------------------------------------------------
# DEX with Fiat — Frontend environment configuration
# Copy to `.env.local` and fill in real values. Never commit secrets.
# ---------------------------------------------------------------------------

# --- App / API ---
VITE_API_BASE_URL=http://localhost:8080
VITE_CHAIN_ID=1

# --- Wallet / RPC ---
VITE_RPC_URL=http://localhost:8545
VITE_WALLETCONNECT_PROJECT_ID=

# --- Feature flags ---
VITE_ENABLE_TESTNET=false

# ---------------------------------------------------------------------------
# Observability: withdrawal queue & payout reconciliation alerting (#121)
#
# Thresholds are evaluated by the observability alert evaluator. Each alert is
# deduplicated by a stable key and auto-cleared once the condition recovers.
# Values below are the defaults; override per environment as needed.
# ---------------------------------------------------------------------------

# Withdrawal queue age (seconds since the oldest pending withdrawal was created)
VITE_ALERT_WITHDRAWAL_QUEUE_AGE_WARN_SECONDS=900
VITE_ALERT_WITHDRAWAL_QUEUE_AGE_CRIT_SECONDS=3600

# Withdrawal queue depth (number of pending withdrawals awaiting processing)
VITE_ALERT_WITHDRAWAL_QUEUE_DEPTH_WARN=25
VITE_ALERT_WITHDRAWAL_QUEUE_DEPTH_CRIT=100

# Indexer lag (seconds between chain head and last indexed block)
VITE_ALERT_INDEXER_LAG_WARN_SECONDS=60
VITE_ALERT_INDEXER_LAG_CRIT_SECONDS=300

# Webhook backlog (undelivered provider webhooks awaiting retry)
VITE_ALERT_WEBHOOK_BACKLOG_WARN=50
VITE_ALERT_WEBHOOK_BACKLOG_CRIT=250

# Payout reconciliation age (seconds since the last successful reconciliation)
VITE_ALERT_RECONCILIATION_AGE_WARN_SECONDS=1800
VITE_ALERT_RECONCILIATION_AGE_CRIT_SECONDS=7200

# Expected user approval delay (seconds). Withdrawals younger than this are
# classified as "awaiting_user_approval" and do NOT raise provider-failure
# alerts, so expected approval latency is separated from genuine failures.
VITE_ALERT_USER_APPROVAL_GRACE_SECONDS=1800

# Deduplication window (seconds). Repeated threshold crossings within this
# window for the same alert key are collapsed into a single notification.
VITE_ALERT_DEDUPE_WINDOW_SECONDS=600

# Operator action links surfaced in alert context (safe, non-sensitive).
VITE_ALERT_OPERATOR_RUNBOOK_URL=https://docs.example.com/runbooks/payout-observability
VITE_ALERT_OPERATOR_DASHBOARD_URL=https://ops.example.com/dashboards/payouts
